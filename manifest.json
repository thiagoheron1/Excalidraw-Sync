{
  "manifest_version": 3,
  "name": "Excalidraw Sync",
  "version": "0.1.0",
  "description": "Organize Excalidraw files in folders and sync them to GitHub or Google Drive.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "identity"
  ],
  "host_permissions": [
    "https://excalidraw.com/*",
    "https://api.github.com/*",
    "https://github.com/login/*",
    "https://accounts.google.com/*",
    "https://oauth2.googleapis.com/*",
    "https://www.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Excalidraw Sync",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://excalidraw.com/*"],
      "js": ["shared/core.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "excalidraw-sync@thiagoheron.com",
      "strict_min_version": "121.0"
    }
  }
}

